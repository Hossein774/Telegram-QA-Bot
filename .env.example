# Configuration reference. Set these variables in your shell or hosting provider.
# This project does not load .env files automatically.

BOT_TOKEN=your_bot_token_from_botfather
GROUP_ID=-100123456789

# Optional: leave both empty to disable the subscription requirement.
CHANNEL_ID=
CHANNEL_URL=

# Optional settings (defaults shown).
QUESTION_COOLDOWN=600
MAX_QUESTIONS=50
DOMAIN=
WEBHOOK_SETUP_KEY=generate_a_long_random_secret
WEBHOOK_SECRET_TOKEN=generate_a_separate_random_secret
DB_PATH=bot_data.db
PORT=5000
